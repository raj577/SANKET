# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# PostgreSQL (production)
DATABASE_URL=postgresql+psycopg://sensibull:sensibull@localhost:5432/sensibull
DATABASE_ECHO=false

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
# Concurrent refreshes that present a token rotated within this many seconds
# are treated as racing requests instead of token theft.
REFRESH_RACE_GRACE_SECONDS=60

# One-time bootstrap admin (safe to leave unset after first login exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Collector authentication. Use CLI-created tokens in production.
COLLECTOR_BOOTSTRAP_TOKEN=

# CORS: admin (3000), user (3001) Next.js apps
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CSV archive storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/sensibull
STORAGE_MAX_CSV_BYTES=26214400

# Optional S3 / R2
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=sensibull

# Scanner
SCANNER_MIN_GRADE=C
SCANNER_ALLOW_PUBLISH_WITHOUT_STOP_LOSS=false

# Market data provider: fyers | kotak
MARKET_DATA_PROVIDER=fyers
# websocket uses the provider's streaming feed; rest polls quotes instead
MARKET_DATA_TRANSPORT=websocket
MARKET_DATA_TICK_THROTTLE_SECONDS=2
# Option-chain provider for the admin OI scan: fyers | kotak
SCANNER_DATA_PROVIDER=fyers

# FYERS market data (data-only; no order placement)
# Create an "Individual - Non Trading" app in the FYERS API dashboard and use
# the exact redirect URI below (it must match the dashboard byte for byte).
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/market/fyers/callback

# Encrypted token storage. Generate the key once and keep it stable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or rotating this key invalidates the stored token (log in again).
# There is no plaintext fallback: without this key, token storage is refused.
FYERS_TOKEN_FILE=storage/fyers_token.bin
FYERS_TOKEN_ENCRYPTION_KEY=

# Signed OAuth state lifetime (seconds) and fallback token lifetime used only
# when FYERS does not report an expiry.
FYERS_OAUTH_STATE_TTL_SECONDS=300
FYERS_TOKEN_ASSUMED_TTL_SECONDS=43200

# Development-only shortcut. Prefer the OAuth callback, which stores an
# encrypted token; this variable is read as a last-resort override.
FYERS_ACCESS_TOKEN=

# AVWAP pattern scanner (independent of the OI scanner, reuses FYERS history).
# FYERS Standard plan allows 50 history requests/minute; keep the pause at or
# above 1.3 seconds (about 46 requests/minute) or scans will hit 429s.
PATTERN_DEFAULT_TIMEFRAME=60
PATTERN_TIMEFRAMES=5,15,60,D
PATTERN_LOOKBACK_DAYS=120
PATTERN_HISTORY_CHUNK_DAYS=60
PATTERN_HISTORY_PAUSE_SECONDS=1.3
PATTERN_MAX_SYMBOLS=25
PATTERN_INSTRUMENT_MASTER_URL=https://public.fyers.in/sym_details/NSE_FO.csv
PATTERN_INSTRUMENT_CACHE_TTL_SECONDS=3600

# Kotak Neo market data (no order placement)
# Quotes + scrip master only need the consumer key. The SFeed websocket needs
# mobile number, UCC, MPIN and the TOTP secret registered in the NEO app.
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
KOTAK_ENVIRONMENT=prod
KOTAK_SCRIP_CACHE_PATH=storage/kotak_scrip_nse_cm.csv
KOTAK_QUOTE_TYPE=ltp
KOTAK_STREAM_REFRESH_SECONDS=60

TRACKING_POLL_SECONDS=15
PRICE_PERSIST_INTERVAL_SECONDS=60
PRICE_STALE_AFTER_SECONDS=300

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
