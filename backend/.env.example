# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# PostgreSQL (production)
DATABASE_URL=postgresql+psycopg://sensibull:sensibull@localhost:5432/sensibull
DATABASE_ECHO=false

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# One-time bootstrap admin (safe to leave unset after first login exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Collector authentication. Use CLI-created tokens in production.
COLLECTOR_BOOTSTRAP_TOKEN=

# CORS: admin (3000), user (3001) Next.js apps
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CSV archive storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/sensibull
STORAGE_MAX_CSV_BYTES=26214400

# Optional S3 / R2
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=sensibull

# Scanner
SCANNER_MIN_GRADE=C
SCANNER_ALLOW_PUBLISH_WITHOUT_STOP_LOSS=false

# Market data provider: fyers | kotak
MARKET_DATA_PROVIDER=fyers
# websocket uses the provider's streaming feed; rest polls quotes instead
MARKET_DATA_TRANSPORT=websocket
MARKET_DATA_TICK_THROTTLE_SECONDS=2

# FYERS market data (no order placement)
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/market/fyers/callback
FYERS_ACCESS_TOKEN=
FYERS_TOKEN_FILE=storage/fyers_token.json

# Kotak Neo market data (no order placement)
# Quotes + scrip master only need the consumer key. The SFeed websocket needs
# mobile number, UCC, MPIN and the TOTP secret registered in the NEO app.
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
KOTAK_ENVIRONMENT=prod
KOTAK_SCRIP_CACHE_PATH=storage/kotak_scrip_nse_cm.csv
KOTAK_QUOTE_TYPE=ltp
KOTAK_STREAM_REFRESH_SECONDS=60

TRACKING_POLL_SECONDS=15
PRICE_PERSIST_INTERVAL_SECONDS=60
PRICE_STALE_AFTER_SECONDS=300

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
