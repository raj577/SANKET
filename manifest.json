{
    "manifest_version": 3,
    "name": "Sensibull OI Scanner",
    "version": "3.3",
    "permissions": [
        "activeTab",
        "downloads",
        "storage",
        "alarms",
        "notifications",
        "scripting"
    ],
    "host_permissions": [
        "https://web.sensibull.com/*",
        "https://oxide.sensibull.com/*",
        "https://api.telegram.org/*",
        "https://sheets.googleapis.com/*",
        "https://accounts.google.com/*",
        "https://sankt.duckdns.org/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://web.sensibull.com/*"
            ],
            "js": [
                "csv-utils.js",
                "content.js"
            ]
        }
    ]
}
